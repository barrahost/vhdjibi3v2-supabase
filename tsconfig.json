{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "firebase/firestore": ["./src/lib/firebaseCompat.ts"],
      "firebase/auth":      ["./src/lib/firebaseAuthCompat.ts"],
      "firebase/app":       ["./src/lib/firebaseStub.ts"],
      "firebase/storage":   ["./src/lib/firebaseStub.ts"],
      "firebase/functions": ["./src/lib/firebaseStub.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
